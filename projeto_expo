}

// ═══════════════════════════════════════════════════════════
// PUBLICAR PEDIDO (suporta múltiplos pedidos simultâneos)
// ═══════════════════════════════════════════════════════════
function publicarRota() {
  if (!origem || !destino) { mostrarToast('Defina origem e destino!', 'erro'); return; }
  if (!totalItensPedido())  { mostrarToast('Selecione itens para o pedido!', 'erro'); return; }
  if (distAtualKm == null)  { mostrarToast('Calcule a rota antes de publicar!', 'erro'); return; }

  const vol = calcularVolumePedido();
  if (vol > VOLUME_MAX_BAG) { mostrarToast(`Volume excede a bag (${VOLUME_MAX_BAG} L)`, 'erro'); return; }

  // Construir lista de itens agrupados
  const itens = Object.entries(pedidoAtual).map(([id, qtd]) => {
    const it = cardapio.find(i => i.id === Number(id));
    return { ...it, qtd };
  });

  const novoPedido = {
    id: Date.now(),
    origem:  { ...origem },
    destino: { ...destino },
    itens,
    distKm:  distAtualKm,
    tempoMin: calcularTempoMinutos(distAtualKm),
    precoEntrega: calcularPrecoEntrega(distAtualKm),
    pesoTotal:   calcularPesoPedido(),
    volumeTotal: calcularVolumePedido(),
    vendaTotal:  calcularVendaPedido(),
    lucroTotal:  calcularLucroPedido(),
    status: 'aguardando',  // aguardando | aceito | entregue | cancelado
    criadoEm: new Date().toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit' })
  };

  pedidos.push(novoPedido);

  // Limpa o formulário para permitir criar outro pedido
  limparPedidoAtual();

  renderizarPedidosPublicados();
  renderizarRotasMotoboy();
  mostrarToast(`Pedido #${novoPedido.id.toString().slice(-4)} publicado!`);
}

