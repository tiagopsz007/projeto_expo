async function buscarEndereco(tipo) {
  const inputId  = tipo === 'origem' ? 'endOrigem' : 'endDestino';
  const statusId = tipo === 'origem' ? 'statusOrigem' : 'statusDestino';
  const val      = document.getElementById(inputId).value.trim();
  const statusEl = document.getElementById(statusId);

  if (!val) { mostrarToast('Digite um endereço ou CEP', 'erro'); return; }
  statusEl.textContent = '⏳ Buscando...';

  try {
    let endereco = val;
    const cep = val.replace(/\D/g, '');
    if (cep.length === 8) {
      const r = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
      const d = await r.json();
      if (d.erro) { statusEl.textContent = '❌ CEP não encontrado'; return; }
      endereco = `${d.logradouro}, ${d.localidade}, ${d.uf}, Brasil`;
    } else {
      endereco += ', Brasil';
    }

    const r2 = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(endereco)}`);
    const d2 = await r2.json();
    if (!d2.length) { statusEl.textContent = '❌ Endereço não encontrado'; return; }

    const lat  = parseFloat(d2[0].lat);
    const lng  = parseFloat(d2[0].lon);

    if (tipo === 'origem') {
      origem = { lat, lng, nome: val };
      if (lyr.rest.origem) mapRest.removeLayer(lyr.rest.origem);
      lyr.rest.origem = L.marker([lat,lng], { icon: mkIcon('🍽️') })
        .bindPopup(`🍽️ Restaurante: ${val}`).addTo(mapRest);
      mapRest.setView([lat,lng], 14);
      statusEl.textContent = '✅ Origem definida!';
      mostrarToast('Origem definida!');
    } else {
      destino = { lat, lng, nome: val };
      if (lyr.rest.destino) mapRest.removeLayer(lyr.rest.destino);
      lyr.rest.destino = L.marker([lat,lng], { icon: mkIcon('📍') })
        .bindPopup(`📍 Cliente: ${val}`).addTo(mapRest);
      mapRest.setView([lat,lng], 14);
      statusEl.textContent = '✅ Destino definido!';
      mostrarToast('Destino definido!');
