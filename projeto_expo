// ═══════════════════════════════════════════════════════════
// CALCULAR ROTA (GraphHopper) — retorna distKm, coords, instruções
// ═══════════════════════════════════════════════════════════

// Ícones de manobra do GraphHopper → emoji
const TURN_ICONS = {
  'turn-sharp-left':  '↰', 'turn-left':  '←', 'turn-slight-left':  '↖',
  'turn-sharp-right': '↱', 'turn-right': '→', 'turn-slight-right': '↗',
  'continue':     '⬆', 'finish': '🏁', 'reached_via': '📍',
  'roundabout':   '🔄', 'leave_roundabout': '↪', 'use_roundabout': '🔄',
  'keep-left':    '↙', 'keep-right': '↘',
  'u_turn_unknown': '↩', 'u_turn_left': '↩', 'u_turn_right': '↪',
};

function iconeTurn(sign, text) {
  // sign é o número de código GH; text é o nome textual
  if (text) {
    for (const [k, v] of Object.entries(TURN_ICONS)) {
      if (text.toLowerCase().includes(k.replace(/-/g,' ').split(' ')[0])) return v;
    }
  }
  // fallback pelo código numérico
  const map = { '-3':'↰','-2':'←','-1':'↖','0':'⬆','1':'↗','2':'→','3':'↱','4':'🏁','5':'📍','6':'🔄','7':'↪' };
  return map[String(sign)] || '⬆';
}

function formatDist(m) {
  if (m < 1000) return `${Math.round(m)} m`;
  return `${(m/1000).toFixed(1)} km`;
}

async function ghRoute(points) {
  const key = obterApiKey();
  if (!key) throw new Error('SEM_KEY');

  const pts = points.map(p => `point=${p.lat},${p.lng}`).join('&');
  const url = `https://graphhopper.com/api/1/route?${pts}&profile=car&points_encoded=false&instructions=true&locale=pt_BR&key=${encodeURIComponent(key)}`;
  const r = await fetch(url);
  const d = await r.json();
  if (!d.paths?.length) throw new Error(d.message || 'Rota não encontrada');
  const path   = d.paths[0];
  const distKm = path.distance / 1000;
  const coords = path.points.coordinates.map(c => [c[1], c[0]]);
  const instrucoes = (path.instructions || []).map(inst => ({
    texto:       inst.text || '',
    sign:        inst.sign,
    distancia:   inst.distance || 0,
    tempo:       inst.time || 0,
    rua:         inst.street_name || '',
  }));
  return { distKm, coords, instrucoes };
}

async function calcularRota(modo) {
  let o, d;
  if (modo === 'rest') {
    o = origem; d = destino;
  } else {
    const pedido = pedidos.find(p => p.id === pedidoSelecionadoId);
    if (!pedido) { mostrarToast('Selecione um pedido aceito primeiro', 'erro'); return; }
    o = pedido.origem; d = pedido.destino;
  }

  if (!o || !d) { mostrarToast('Defina origem e destino primeiro!', 'erro'); return; }

  try {
    const resultado = await ghRoute([o, d]);
    const { distKm, coords } = resultado;
    const mapAlvo = modo === 'rest' ? mapRest : mapMoto;

    if (lyr[modo].rota) mapAlvo.removeLayer(lyr[modo].rota);
    lyr[modo].rota = L.polyline(coords, { color:'#ff6b00', weight:5, opacity:0.9 }).addTo(mapAlvo);
    mapAlvo.fitBounds(lyr[modo].rota.getBounds(), { padding:[28,28] });

    if (modo === 'rest') distAtualKm = distKm;

    atualizarInfoEntrega(modo, distKm);
    mostrarToast(`Rota: ${distKm.toFixed(2)} km · ${calcularTempoMinutos(distKm)} min · R$ ${calcularPrecoEntrega(distKm).toFixed(2)}`);
  } catch(e) {
    if (e.message === 'SEM_KEY') {
      mostrarToast('Cole sua API Key GraphHopper na barra no topo!', 'erro');
    } else {
      mostrarToast('Erro ao calcular rota: ' + e.message, 'erro');
    }
  }
}

// ═══════════════════════════════════════════════════════════
// PONTOS DO MAPA
// ═══════════════════════════════════════════════════════════
function atualizarPontos(modo) {
  const el = document.getElementById(`pontosMapa-${modo}`);
  let o, d;
  if (modo === 'rest') { o = origem; d = destino; }
  else {
    const pedido = pedidos.find(p => p.id === pedidoSelecionadoId);
    o = pedido?.origem; d = pedido?.destino;
  }

  const pts = [];
  if (o) pts.push({ label:'R', cor:'ponto-R', emoji:'🍽️', nome: o.nome });
  if (d) pts.push({ label:'D', cor:'ponto-D', emoji:'📍', nome: d.nome });

  if (!pts.length) {
    el.innerHTML = `<div style="font-size:12px;color:var(--texto-muted);">${modo === 'rest' ? 'Nenhum ponto definido.' : 'Aceite uma rota para ver os pontos.'}</div>`;
    return;
  }
  el.innerHTML = pts.map(p => `
    <div class="ponto-item">
      <div class="ponto-num ${p.cor}">${p.label}</div>
      <span>${p.emoji} ${p.nome}</span>
    </div>
  `).join('');
}

// ═══════════════════════════════════════════════════════════
// LIMPAR MAPA
// ═══════════════════════════════════════════════════════════
function limparMapa(modo) {
  const mapAlvo = modo === 'rest' ? mapRest : mapMoto;
  ['origem','destino','rota'].forEach(k => {
    if (lyr[modo][k]) { mapAlvo.removeLayer(lyr[modo][k]); lyr[modo][k] = null; }
  });
  if (modo === 'moto' && lyr.moto.paradas) {
    lyr.moto.paradas.forEach(m => mapMoto.removeLayer(m));
    lyr.moto.paradas = [];
  }

  if (modo === 'rest') {
    origem = destino = null;
    distAtualKm = null;
    document.getElementById('statusOrigem').textContent = '';
    document.getElementById('statusDestino').textContent = '';
    document.getElementById('endOrigem').value = '';
    document.getElementById('endDestino').value = '';
  } else {
    pedidoSelecionadoId = null;
    rotaCombinadaCache = null;
    renderizarInstrucoes();
  }
  atualizarInfoEntrega(modo, null);
  if (modo === 'moto') atualizarParadasMotoboy();
  else atualizarPontos(modo);
  mostrarToast('Mapa limpo!');
}

// ═══════════════════════════════════════════════════════════
// MENU (cadastro de itens) - SÓ ADICIONA AO MENU
// ═══════════════════════════════════════════════════════════
function adicionarItem() {
  const nome   = document.getElementById('itemNome').value.trim();
  const emoji  = document.getElementById('itemEmoji').value.trim() || '🍽️';
  const peso   = parseFloat(document.getElementById('itemPeso').value);
  const volume = parseFloat(document.getElementById('itemVolume').value);
  const preco  = parseFloat(document.getElementById('itemPreco').value);
  const lucro  = parseFloat(document.getElementById('itemLucro').value);

  if (!nome || isNaN(peso) || isNaN(volume) || isNaN(preco) || isNaN(lucro)) {
    mostrarToast('Preencha todos os campos!', 'erro'); return;
  }
  const id = Date.now();
  cardapio.push({ nome, emoji, peso, volume, preco, lucro, id });
  ['itemNome','itemEmoji','itemPeso','itemVolume','itemPreco','itemLucro'].forEach(idCampo => document.getElementById(idCampo).value = '');
  renderizarCardapio();
  renderizarPedidoSelector();
  mostrarToast('Item adicionado ao menu!');
}

function removerItem(id) {
  cardapio = cardapio.filter(i => i.id !== id);
  delete pedidoAtual[id];
  renderizarCardapio();
  renderizarPedidoSelector();
  atualizarResumoPedido();
}

function renderizarCardapio() {
  const tbody = document.getElementById('tabelaItens');
  const empty = document.getElementById('emptyCardapio');
  if (!cardapio.length) { tbody.innerHTML = ''; empty.style.display = 'block'; return; }
  empty.style.display = 'none';
  tbody.innerHTML = cardapio.map(it => `
    <tr>
      <td><div class="nome-cell"><span style="font-size:18px">${it.emoji}</span>${it.nome}</div></td>
      <td><span class="badge">${it.peso} kg</span></td>
      <td><span class="badge">${it.volume} L</span></td>
      <td>R$ ${it.preco.toFixed(2)}</td>
      <td class="lucro-val">R$ ${it.lucro.toFixed(2)}</td>
      <td><button class="btn btn-secondary btn-sm" style="color:var(--vermelho);padding:5px 10px;font-size:11px;" onclick="removerItem(${it.id})">✕</button></td>
    </tr>
  `).join('');
}

// ═══════════════════════════════════════════════════════════
// SELETOR DE ITENS PARA O PEDIDO
// ═══════════════════════════════════════════════════════════
function renderizarPedidoSelector() {
  const el = document.getElementById('pedidoSelector');
  if (!cardapio.length) {
    el.innerHTML = '<div class="empty" style="padding:20px;"><div style="font-size:13px;">Cadastre itens no menu primeiro.</div></div>';
    return;
  }
  el.innerHTML = cardapio.map(it => {
    const qtd = pedidoAtual[it.id] || 0;
    return `
      <div class="pedido-item-selector">
        <div class="pedido-item-selector-left">
          <span style="font-size:20px">${it.emoji}</span>
          <div>
            <div>${it.nome}</div>
            <div style="font-size:11px;color:var(--texto-muted);">⚖️ ${it.peso} kg · 📦 ${it.volume} L · R$ ${it.preco.toFixed(2)}</div>
          </div>
        </div>
        <div class="qtd-controls">
          <button class="qtd-btn" onclick="ajustarQtd(${it.id}, -1)">−</button>
          <span class="qtd-display">${qtd}</span>
          <button class="qtd-btn" onclick="ajustarQtd(${it.id}, 1)">+</button>
        </div>
      </div>
    `;
  }).join('');
}

function ajustarQtd(itemId, delta) {
  const atual = pedidoAtual[itemId] || 0;
  const nova  = Math.max(0, atual + delta);

  // verificar se cabe na bag (84.7L)
  if (delta > 0) {
    const item = cardapio.find(i => i.id === itemId);
    const volumeTotal = calcularVolumePedido() + item.volume;
    if (volumeTotal > VOLUME_MAX_BAG) {
      mostrarToast(`Excede a bag (${VOLUME_MAX_BAG} L)`, 'erro');
      return;
    }
  }

  if (nova === 0) delete pedidoAtual[itemId];
  else pedidoAtual[itemId] = nova;

  renderizarPedidoSelector();
  atualizarResumoPedido();
}

function calcularVolumePedido() {
  return Object.entries(pedidoAtual).reduce((sum, [id, qtd]) => {
    const it = cardapio.find(i => i.id === Number(id));
    return sum + (it ? it.volume * qtd : 0);
  }, 0);
}

function calcularPesoPedido() {
  return Object.entries(pedidoAtual).reduce((sum, [id, qtd]) => {
    const it = cardapio.find(i => i.id === Number(id));
    return sum + (it ? it.peso * qtd : 0);
  }, 0);
}

function calcularLucroPedido() {
  return Object.entries(pedidoAtual).reduce((sum, [id, qtd]) => {
    const it = cardapio.find(i => i.id === Number(id));
    return sum + (it ? it.lucro * qtd : 0);
  }, 0);
}

function calcularVendaPedido() {
  return Object.entries(pedidoAtual).reduce((sum, [id, qtd]) => {
    const it = cardapio.find(i => i.id === Number(id));
    return sum + (it ? it.preco * qtd : 0);
  }, 0);
}

function totalItensPedido() {
  return Object.values(pedidoAtual).reduce((a,b) => a+b, 0);
}

function atualizarResumoPedido() {
  const el = document.getElementById('resumoPedido');
  const total = totalItensPedido();
  if (!total) { el.innerHTML = ''; return; }

  const peso   = calcularPesoPedido();
  const vol    = calcularVolumePedido();
  const venda  = calcularVendaPedido();
  const lucro  = calcularLucroPedido();
  const pctVol = (vol / VOLUME_MAX_BAG * 100).toFixed(1);

  el.innerHTML = `
    <div class="resultado" style="display:block;margin-top:14px;">
      <div class="resultado-header"><span style="font-size:22px">🛒</span><h2 style="font-size:20px;">Resumo do Pedido</h2></div>
      <div class="stats-grid">
        <div class="stat-box"><div class="stat-label">Itens</div><div class="stat-value">${total}</div></div>
        <div class="stat-box"><div class="stat-label">Total Venda</div><div class="stat-value">R$ ${venda.toFixed(2)}</div></div>
        <div class="stat-box"><div class="stat-label">Lucro</div><div class="stat-value" style="color:var(--verde);">R$ ${lucro.toFixed(2)}</div></div>
        <div class="stat-box"><div class="stat-label">Peso</div><div class="stat-value">${peso.toFixed(2)}<span style="font-size:12px"> kg</span></div></div>
        <div class="stat-box"><div class="stat-label">Volume</div><div class="stat-value">${vol.toFixed(2)}<span style="font-size:12px"> L</span></div><div class="stat-sub">${pctVol}% de ${VOLUME_MAX_BAG} L</div></div>
      </div>
      <div class="progress-label"><span>📦 Volume da Bag</span><span>${vol.toFixed(2)} / ${VOLUME_MAX_BAG} L</span></div>
      <div class="progress-bar"><div class="progress-fill fill-vol" style="width:${Math.min(100,pctVol)}%"></div></div>
    </div>
  `;
}

function limparPedidoAtual() {
  pedidoAtual = {};
  origem = destino = null;
  distAtualKm = null;
  document.getElementById('endOrigem').value = '';
  document.getElementById('endDestino').value = '';
  document.getElementById('statusOrigem').textContent = '';
  document.getElementById('statusDestino').textContent = '';
  ['origem','destino','rota'].forEach(k => {
    if (lyr.rest[k]) { mapRest.removeLayer(lyr.rest[k]); lyr.rest[k] = null; }
  });
  atualizarInfoEntrega('rest', null);
  atualizarPontos('rest');
  renderizarPedidoSelector();
  atualizarResumoPedido();
