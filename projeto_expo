      mapRest.fitBounds([[origem.lat,origem.lng],[destino.lat,destino.lng]], { padding:[40,40] });
    }
  } catch {
    statusEl.textContent = '❌ Erro ao buscar';
    mostrarToast('Erro ao buscar endereço', 'erro');
  }
}

