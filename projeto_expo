// ═══════════════════════════════════════════════════════════
// CANCELAR PEDIDO (RESTAURANTE)
// ═══════════════════════════════════════════════════════════
async function cancelarPedido(id) {
  const p = pedidos.find(x => x.id === id);
  if (!p) return;
  if (!confirm(`Cancelar o pedido #${id.toString().slice(-4)}?`)) return;

  const eraAceito = p.status === 'aceito';
  p.status = 'cancelado';
  p.canceladoEm = new Date().toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit' });

  // Se foi cancelado um pedido que o motoboy tinha aceitado, recalcular rota
  if (eraAceito) {
    const restantes = pedidos.filter(x => x.status === 'aceito');
    if (restantes.length) {
      try {
        rotaCombinadaCache = await calcularRotaCombinada(restantes);
        desenharRotaCombinadaNoMapa();
      } catch {}
    } else {
      // sem nenhum aceito, limpa o mapa do motoboy
      rotaCombinadaCache = null;
      pedidoSelecionadoId = null;
      ['origem','destino','rota'].forEach(k => {
        if (lyr.moto[k]) { mapMoto.removeLayer(lyr.moto[k]); lyr.moto[k] = null; }
      });
      if (lyr.moto.paradas) { lyr.moto.paradas.forEach(m => mapMoto.removeLayer(m)); lyr.moto.paradas = []; }
      atualizarInfoEntrega('moto', null);
      atualizarParadasMotoboy();
    }
  }

  renderizarPedidosPublicados();
  renderizarRotasMotoboy();
  mostrarToast('Pedido cancelado', 'info');
}

