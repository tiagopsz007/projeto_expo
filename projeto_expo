<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MotoRota — Delivery System</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<style>
:root {
  --vermelho: #e8321a;
  --laranja: #ff6b00;
  --amarelo: #ffd600;
  --escuro: #0d0d0d;
  --cinza-escuro: #161616;
  --cinza-medio: #222222;
  --cinza-claro: #333333;
  --texto: #f0ede8;
  --texto-muted: #777;
  --verde: #3ddc84;
  --azul: #4da6ff;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  background: var(--escuro);
  color: var(--texto);
  font-family: 'DM Sans', sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ─── TOPBAR ─── */
.topbar {
  background: var(--cinza-escuro);
  border-bottom: 2px solid var(--cinza-claro);
  padding: 0 32px;
  display: flex;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 500;
}

.logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 28px;
  letter-spacing: 3px;
  color: var(--amarelo);
  text-shadow: 2px 2px 0 var(--vermelho);
  padding: 16px 0;
  margin-right: 40px;
  flex-shrink: 0;
}

.tabs { display: flex; height: 100%; }

.tab-btn {
  background: none;
  border: none;
  color: var(--texto-muted);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 16px;
  letter-spacing: 2px;
  padding: 18px 28px;
  cursor: pointer;
  border-bottom: 3px solid transparent;
  transition: all 0.2s;
}
.tab-btn:hover { color: var(--texto); }
.tab-btn.active { color: var(--amarelo); border-bottom-color: var(--vermelho); }

/* ─── PAGES ─── */
.page { display: none; }
.page.active { display: block; }

/* ─── HERO ─── */
.hero {
  background: var(--cinza-escuro);
  border-bottom: 3px solid var(--vermelho);
  padding: 28px 40px;
  position: relative;
  overflow: hidden;
}
.hero::before {
  position: absolute; right: 40px; top: 50%;
  transform: translateY(-50%);
  font-size: 110px; opacity: 0.06; pointer-events: none;
}
.restaurante-hero::before { content: '🍔'; }
.motoboy-hero::before     { content: '🏍️'; }

.hero-tag {
  display: inline-block;
  background: var(--vermelho); color: #fff;
  font-family: 'Bebas Neue', sans-serif;
  letter-spacing: 2px; font-size: 11px;
  padding: 3px 10px; border-radius: 4px; margin-bottom: 10px;
}
.hero h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 48px; letter-spacing: 3px; line-height: 1;
  color: var(--amarelo); text-shadow: 3px 3px 0 var(--vermelho); margin-bottom: 8px;
}
.hero p { color: var(--texto-muted); font-size: 14px; max-width: 500px; line-height: 1.6; }

/* ─── LAYOUT ─── */
.page-body { padding: 28px 40px; display: flex; flex-direction: column; gap: 24px; }
.row { display: grid; gap: 24px; }
.row-2col { grid-template-columns: 340px 1fr; }
.row-mapa { grid-template-columns: 300px 1fr; }

/* ─── CARD ─── */
.card {
  background: var(--cinza-escuro);
  border: 1px solid var(--cinza-claro);
  border-radius: 14px; padding: 24px;
}
.card-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 18px; letter-spacing: 2px;
  color: var(--amarelo); margin-bottom: 16px;
  display: flex; align-items: center; gap: 8px;
}

/* ─── FORM ─── */
.input-group { display: flex; flex-direction: column; margin-bottom: 12px; }
.input-group:last-child { margin-bottom: 0; }

label {
  font-size: 11px; font-weight: 700;
  color: var(--texto-muted); text-transform: uppercase;
  letter-spacing: 1px; margin-bottom: 6px;
}

input, select {
  background: var(--cinza-medio);
  border: 1px solid var(--cinza-claro);
  border-radius: 8px; color: var(--texto);
  font-family: 'DM Sans', sans-serif;
  font-size: 15px; padding: 11px 14px;
  transition: border-color 0.2s; outline: none; width: 100%;
}
input:focus, select:focus { border-color: var(--laranja); }
input::placeholder { color: #444; }
select option { background: var(--cinza-medio); }

.row-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

/* ─── BOTÕES ─── */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 8px; border: none; border-radius: 10px;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 18px; letter-spacing: 2px; padding: 13px 20px;
  cursor: pointer; transition: all 0.2s; width: 100%;
}
.btn-primary { background: var(--vermelho); color: #fff; }
.btn-primary:hover { background: #c82a12; transform: translateY(-1px); }
.btn-secondary { background: var(--cinza-claro); color: var(--texto); }
.btn-secondary:hover { background: #444; }
.btn-verde { background: var(--verde); color: #000; }
.btn-verde:hover { background: #30c070; transform: translateY(-1px); }
.btn-azul { background: var(--azul); color: #000; }
.btn-azul:hover { background: #3a90e0; }
.btn-laranja { background: var(--laranja); color: #000; }
.btn-laranja:hover { background: #e05a00; }
.btn-sm { font-size: 13px; padding: 7px 14px; border-radius: 7px; width: auto; letter-spacing: 1px; }
.btn-danger { background: var(--vermelho); color: #fff; }
.btn-danger:hover { background: #c82a12; }

/* ─── TABELA ─── */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
thead tr { background: var(--cinza-medio); }
th {
  padding: 10px 14px; text-align: left;
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 1.5px;
  color: var(--texto-muted); border-bottom: 2px solid var(--cinza-claro);
}
td { padding: 11px 14px; border-bottom: 1px solid var(--cinza-claro); vertical-align: middle; }
tbody tr:hover { background: var(--cinza-medio); }

.badge {
  display: inline-block; background: var(--cinza-medio);
  border: 1px solid var(--cinza-claro); border-radius: 5px;
  padding: 2px 7px; font-size: 11px; color: var(--texto-muted);
}
.lucro-val { font-weight: 700; color: var(--verde); }
.nome-cell { display: flex; align-items: center; gap: 8px; font-weight: 500; }

/* ─── MAPA ─── */
.mapa-container {
  width: 100%; height: 420px;
  border-radius: 12px; border: 1px solid var(--cinza-claro);
  overflow: hidden;
}

/* ─── PONTOS ─── */
.ponto-item {
  padding: 8px 12px; background: var(--cinza-medio);
  border-radius: 7px; font-size: 12px;
  display: flex; align-items: flex-start; gap: 8px; line-height: 1.4;
}
.ponto-num {
  font-family: 'Bebas Neue', sans-serif; font-size: 13px;
  width: 20px; height: 20px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.ponto-R { background: var(--vermelho); color: #fff; }
.ponto-D { background: var(--verde); color: #000; }

/* ─── DIST INFO ─── */
.dist-info {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 28px; color: var(--amarelo); letter-spacing: 1px;
}
.tempo-info {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 22px; color: var(--azul); letter-spacing: 1px;
}
.preco-info {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 26px; color: var(--verde); letter-spacing: 1px;
}

/* ─── RESULTADO OTIMIZAÇÃO ─── */
.resultado {
  display: none;
  background: var(--cinza-escuro);
  border: 1px solid var(--cinza-claro);
  border-top: 4px solid var(--verde);
  border-radius: 12px; padding: 24px;
  animation: slideIn 0.35s cubic-bezier(0.22,1,0.36,1);
}
@keyframes slideIn {
  from { opacity:0; transform:translateY(14px); }
  to   { opacity:1; transform:translateY(0); }
}
.resultado.erro { border-top-color: var(--vermelho); }
.resultado h2 { font-family: 'Bebas Neue', sans-serif; font-size: 24px; letter-spacing: 2px; color: var(--verde); }
.resultado.erro h2 { color: var(--vermelho); }
.resultado-header { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 10px; margin-bottom: 18px;
}
.stat-box { background: var(--cinza-medio); border: 1px solid var(--cinza-claro); border-radius: 10px; padding: 12px 14px; }
.stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--texto-muted); margin-bottom: 4px; font-weight: 700; }
.stat-value { font-family: 'Bebas Neue', sans-serif; font-size: 24px; color: var(--amarelo); line-height: 1; }
.stat-sub { font-size: 11px; color: var(--texto-muted); margin-top: 2px; }

.progress-label { display: flex; justify-content: space-between; font-size: 11px; color: var(--texto-muted); margin-bottom: 5px; }
.progress-bar { height: 7px; background: var(--cinza-claro); border-radius: 99px; overflow: hidden; margin-bottom: 12px; }
.progress-fill { height: 100%; border-radius: 99px; transition: width 0.6s cubic-bezier(0.22,1,0.36,1); }
.fill-peso { background: linear-gradient(90deg, var(--laranja), var(--amarelo)); }
.fill-vol  { background: linear-gradient(90deg, var(--vermelho), var(--laranja)); }

.itens-title { font-family: 'Bebas Neue', sans-serif; font-size: 16px; letter-spacing: 2px; color: var(--texto); margin: 14px 0 10px; }
.item-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 13px; background: var(--cinza-medio);
  border: 1px solid var(--cinza-claro); border-radius: 9px; margin-bottom: 7px;
  flex-wrap: wrap; gap: 8px;
}
.item-row-left { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 13px; }
.item-row-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.qtd-badge { background: var(--vermelho); color: #fff; font-family: 'Bebas Neue', sans-serif; font-size: 14px; padding: 2px 9px; border-radius: 5px; }
.meta-chip { font-size: 11px; color: var(--texto-muted); background: var(--cinza-escuro); border: 1px solid var(--cinza-claro); padding: 3px 7px; border-radius: 5px; }
.lucro-chip { font-weight: 700; font-size: 13px; color: var(--verde); }

/* ─── ROTA CARD (motoboy) ─── */
.rota-card {
  background: var(--cinza-medio);
  border: 1px solid var(--cinza-claro);
  border-left: 4px solid var(--laranja);
  border-radius: 10px; padding: 18px;
  display: flex; flex-direction: column; gap: 12px;
  margin-bottom: 12px;
}
.rota-card.aceita    { border-left-color: var(--verde); }
.rota-card.entregue  { border-left-color: var(--azul); opacity: 0.75; }
.rota-card.cancelada { border-left-color: var(--vermelho); opacity: 0.6; }

.status-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 12px; font-weight: 700; padding: 4px 12px;
  border-radius: 20px; letter-spacing: 0.5px; width: fit-content;
}
.status-aguardando { background: rgba(255,107,0,0.15); color: var(--laranja); border: 1px solid var(--laranja); }
.status-aceita     { background: rgba(61,220,132,0.15); color: var(--verde); border: 1px solid var(--verde); }
.status-entregue   { background: rgba(77,166,255,0.15); color: var(--azul); border: 1px solid var(--azul); }
.status-cancelada  { background: rgba(232,50,26,0.15); color: var(--vermelho); border: 1px solid var(--vermelho); }

/* ─── EMPTY ─── */
.empty { text-align: center; padding: 36px 20px; color: var(--texto-muted); font-size: 14px; }
.empty-icon { font-size: 38px; margin-bottom: 10px; }

/* ─── PEDIDOS ─── */
.pedido-item-selector {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 13px; background: var(--cinza-medio);
  border: 1px solid var(--cinza-claro); border-radius: 9px; margin-bottom: 7px;
  gap: 10px;
}
.pedido-item-selector-left { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 13px; flex: 1; }
.qtd-controls { display: flex; align-items: center; gap: 6px; }
.qtd-btn {
  background: var(--cinza-claro); color: var(--texto);
  border: none; border-radius: 6px;
  width: 28px; height: 28px;
  font-size: 16px; font-weight: 700;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
}
.qtd-btn:hover { background: var(--vermelho); }
.qtd-display {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 16px; min-width: 28px; text-align: center;
  color: var(--amarelo);
}

/* ─── API KEY BAR ─── */
.apikey-bar {
  background: #1a1200;
  border-bottom: 2px solid var(--amarelo);
  padding: 10px 32px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.apikey-bar label {
  font-size: 11px; color: var(--amarelo); text-transform: uppercase;
  letter-spacing: 1px; margin-bottom: 0; white-space: nowrap;
}
.apikey-bar input {
  flex: 1; min-width: 260px; max-width: 480px;
  background: #0d0d0d; border: 1px solid var(--amarelo);
  font-size: 13px; padding: 8px 12px; border-radius: 7px;
  font-family: monospace; color: var(--amarelo);
}
.apikey-bar input:focus { border-color: #fff; color: #fff; }
.apikey-bar .btn-sm { width: auto; font-size: 13px; padding: 8px 16px; }
.apikey-status {
  font-size: 12px; color: var(--texto-muted);
}

/* ─── INSTRUÇÕES PASSO A PASSO ─── */
.instrucoes-card {
  background: var(--cinza-escuro);
  border: 1px solid var(--cinza-claro);
  border-radius: 14px;
  overflow: hidden;
}
.instrucoes-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 20px; cursor: pointer;
  user-select: none;
  border-bottom: 1px solid var(--cinza-claro);
}
.instrucoes-header:hover { background: rgba(255,255,255,0.03); }
.instrucoes-toggle-icon {
  font-size: 18px; transition: transform 0.25s; color: var(--amarelo);
}
.instrucoes-toggle-icon.fechado { transform: rotate(-90deg); }
.instrucoes-body {
  max-height: 600px;
  overflow-y: auto;
  transition: max-height 0.35s cubic-bezier(0.22,1,0.36,1),
              opacity 0.25s ease;
  opacity: 1;
}
.instrucoes-body.fechado {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
}
.instrucao-step {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 10px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.instrucao-step:last-child { border-bottom: none; }
.step-num {
  flex-shrink: 0;
  width: 26px; height: 26px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Bebas Neue', sans-serif; font-size: 13px;
  background: var(--cinza-claro); color: var(--texto-muted);
  margin-top: 1px;
}
.step-num.pickup  { background: rgba(232,50,26,0.25); color: var(--vermelho); border: 1px solid var(--vermelho); }
.step-num.dropoff { background: rgba(61,220,132,0.2); color: var(--verde); border: 1px solid var(--verde); }
.step-icon-turn { font-size: 18px; flex-shrink: 0; margin-top: 2px; }
.step-text { flex: 1; }
.step-street { font-size: 13px; font-weight: 600; color: var(--texto); }
.step-detail { font-size: 11px; color: var(--texto-muted); margin-top: 2px; }
.step-dist { font-size: 11px; color: var(--azul); margin-top: 2px; font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.5px; }
.step-parada-label {
  font-family: 'Bebas Neue', sans-serif; font-size: 13px; letter-spacing: 1px;
  padding: 8px 20px;
  background: var(--cinza-medio);
  color: var(--amarelo);
  border-bottom: 1px solid var(--cinza-claro);
  display: flex; align-items: center; gap: 8px;

  position: fixed; bottom: 28px; left: 50%;
  transform: translateX(-50%) translateY(80px);
  background: var(--cinza-escuro);
  border: 1px solid var(--verde); color: var(--verde);
  font-family: 'Bebas Neue', sans-serif; font-size: 15px; letter-spacing: 1px;
  padding: 12px 28px; border-radius: 10px; z-index: 9999;
  transition: transform 0.35s cubic-bezier(0.22,1,0.36,1); white-space: nowrap;
}
.toast.show { transform: translateX(-50%) translateY(0); }

/* ─── INFO BOX ─── */
.info-box {
  background: rgba(77,166,255,0.08);
  border: 1px solid var(--azul);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 12px;
  color: var(--azul);
  margin-bottom: 12px;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 900px) {
  .hero { padding: 22px 20px; }
  .hero h1 { font-size: 36px; }
  .hero::before { display: none; }
  .page-body { padding: 16px; }
  .row-2col, .row-mapa { grid-template-columns: 1fr; }
  .topbar { padding: 0 16px; }
  .logo { font-size: 22px; margin-right: 16px; }
}
</style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <div class="logo">🏍️ MOTOROTA</div>
  <div class="tabs">
    <button class="tab-btn active" onclick="mudarAba('restaurante', this)">🍽️ RESTAURANTE</button>
    <button class="tab-btn"       onclick="mudarAba('motoboy', this)">🏍️ MOTOBOY</button>
  </div>
</div>

<!-- BARRA DE API KEY 
<div class="apikey-bar">
  <label>🔑 GraphHopper API Key</label>
  <input type="text" id="ghApiKey" placeholder="Cole sua key aqui — graphhopper.com/dashboard → API Keys" oninput="salvarApiKey()">
  <button class="btn btn-laranja btn-sm" onclick="testarApiKey()">✅ TESTAR</button>
  <span class="apikey-status" id="ghKeyStatus">⚠️ Sem key: mapas e rotas ficam cinzas. Crie grátis em <strong>graphhopper.com</strong> → Dashboard → API Keys.</span>
</div>
-->

<!-- ═══════════════════════════════════════════════════════ -->
<!-- ABA RESTAURANTE                                        -->
<!-- ═══════════════════════════════════════════════════════ -->
<div id="page-restaurante" class="page active">

  <div class="hero restaurante-hero">
    <div class="hero-tag">🍽️ PAINEL DO RESTAURANTE</div>
    <h1>Cardápio &<br>Pedidos</h1>
    <p>Monte o cardápio, crie pedidos selecionando itens do menu, defina endereços, calcule o preço e publique para os motoboys.</p>
  </div>

  <div class="page-body">

    <!-- ════════════════════════════════ -->
    <!-- 1) MENU (cadastro de itens)     -->
    <!-- ════════════════════════════════ -->
    <div class="row row-2col">
      <div class="card">
        <div class="card-title">➕ Novo Item do Menu</div>
        <div class="info-box">ℹ️ Esta seção cadastra itens no menu. Para criar pedidos, use a seção abaixo.</div>
        <div class="input-group">
          <label>Nome do item</label>
          <input type="text" id="itemNome" placeholder="Ex: X-Burguer Duplo">
        </div>
        <div class="input-group">
          <label>Emoji</label>
          <input type="text" id="itemEmoji" placeholder="🍔" maxlength="4">
        </div>
        <div class="row-inputs">
          <div class="input-group" style="margin:0;"><label>Peso (kg)</label><input type="number" id="itemPeso" placeholder="0.5" min="0.01" step="0.01"></div>
          <div class="input-group" style="margin:0;"><label>Volume (L)</label><input type="number" id="itemVolume" placeholder="2.5" min="0.01" step="0.01"></div>
        </div>
        <div class="row-inputs" style="margin-top:10px;">
          <div class="input-group" style="margin:0;"><label>Preço (R$)</label><input type="number" id="itemPreco" placeholder="28.00" min="0" step="0.01"></div>
          <div class="input-group" style="margin:0;"><label>Lucro (R$)</label><input type="number" id="itemLucro" placeholder="12.00" min="0" step="0.01"></div>
        </div>
        <button class="btn btn-primary" style="margin-top:14px;" onclick="adicionarItem()">➕ ADICIONAR AO MENU</button>
      </div>

      <div class="card">
        <div class="card-title">🍔 Menu Cadastrado</div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Item</th><th>Peso</th><th>Volume</th><th>Preço</th><th>Lucro</th><th></th></tr></thead>
            <tbody id="tabelaItens"></tbody>
          </table>
          <div id="emptyCardapio" class="empty"><div class="empty-icon">🍽️</div>Nenhum item no menu.<br><span style="font-size:12px;">Adicione itens usando o formulário ao lado.</span></div>
        </div>
      </div>
    </div>

    <!-- ════════════════════════════════ -->
    <!-- 2) CRIAR PEDIDO                  -->
    <!-- ════════════════════════════════ -->
