// ═══════════════════════════════════════════════════════════
// ROTA MULTI-STOP via GraphHopper
// Recebe lista de pedidos aceitos, retorna rota otimizada.
// Lógica: pickup(X) sempre antes de dropoff(X).
// Testa todas as permutações válidas via haversine (rápido),
// depois chama GraphHopper uma vez com a melhor ordem.
// ═══════════════════════════════════════════════════════════
async function calcularRotaCombinada(pedidosAceitos) {
  // Para cada pedido construímos 2 paradas: pickup (origem) e dropoff (destino)
  // Restrição lógica: pickup do pedido X deve vir antes do dropoff X.
  // Com até 3 pedidos = 6 paradas. Testamos todas as permutações válidas e
  // pegamos a de menor distância via OSRM /route (uma chamada por permutação).
  //
  // 3 pedidos → 6!/2³ = 90 ordens válidas (precedência pickup<dropoff).
  // 2 pedidos → 4!/2² = 6.  1 pedido → 1.
  // Para limitar chamadas, com 3 pedidos usamos heurística simples:
  // ir restaurante mais próximo primeiro, e depois entregar o cliente mais
  // próximo, sempre respeitando que só posso entregar o que já peguei.

  // Caso simples: 1 pedido só → rota direta via GraphHopper
  if (pedidosAceitos.length === 1) {
    const p = pedidosAceitos[0];
    const resultado = await ghRoute([p.origem, p.destino]);
    const { distKm, coords, instrucoes } = resultado;
    return {
      ids: [p.id],
      paradas: [
        { tipo: 'pickup',  pedidoId: p.id, lat: p.origem.lat,  lng: p.origem.lng,  nome: p.origem.nome },
        { tipo: 'dropoff', pedidoId: p.id, lat: p.destino.lat, lng: p.destino.lng, nome: p.destino.nome }
      ],
      coords,
      distKm,
      tempoMin: calcularTempoMinutos(distKm),
      instrucoes: [{ pedidoId: p.id, tipo: 'trecho', steps: instrucoes }]
    };
  }

  // Múltiplos pedidos: heurística "vizinho mais próximo" respeitando precedência
  // Começa pelo restaurante do primeiro aceito; a cada passo, escolhe a próxima
  // parada como sendo: o pickup mais próximo (de pedido ainda não retirado) OU
  // o dropoff mais próximo (de pedido já retirado), o que estiver mais perto.
  const haversine = (a, b) => {
    const R = 6371;
    const toRad = x => x * Math.PI / 180;
    const dLat = toRad(b.lat - a.lat);
    const dLng = toRad(b.lng - a.lng);
    const lat1 = toRad(a.lat), lat2 = toRad(b.lat);
    const h = Math.sin(dLat/2)**2 + Math.sin(dLng/2)**2 * Math.cos(lat1) * Math.cos(lat2);
    return 2 * R * Math.asin(Math.sqrt(h));
  };

  const pickups  = pedidosAceitos.map(p => ({ tipo:'pickup',  pedidoId:p.id, lat:p.origem.lat,  lng:p.origem.lng,  nome:p.origem.nome }));
  const dropoffs = pedidosAceitos.map(p => ({ tipo:'dropoff', pedidoId:p.id, lat:p.destino.lat, lng:p.destino.lng, nome:p.destino.nome }));

  // Para garantir menor distância total, testamos todas as ordens válidas com até 3 pedidos.
  // Geramos permutações da sequência de pickups+dropoffs respeitando que
  // pickup(X) sempre vem antes de dropoff(X).
  const todos = [...pickups, ...dropoffs];
  const pedidosIds = pedidosAceitos.map(p => p.id);

  function* permutar(arr) {
    if (arr.length <= 1) { yield arr; return; }
    for (let i = 0; i < arr.length; i++) {
      const resto = [...arr.slice(0,i), ...arr.slice(i+1)];
      for (const sub of permutar(resto)) yield [arr[i], ...sub];
    }
  }

  function ordemValida(seq) {
    const retirados = new Set();
    for (const stop of seq) {
      if (stop.tipo === 'pickup') retirados.add(stop.pedidoId);
      else if (!retirados.has(stop.pedidoId)) return false; // dropoff antes do pickup
    }
    return true;
  }

  // Encontrar a melhor ordem pela distância haversine (rápido, sem chamar OSRM N vezes)
  let melhor = null;
  for (const perm of permutar(todos)) {
    if (!ordemValida(perm)) continue;
    let total = 0;
    for (let i = 1; i < perm.length; i++) total += haversine(perm[i-1], perm[i]);
    if (!melhor || total < melhor.dist) melhor = { seq: perm, dist: total };
  }

  // Agora chamar GraphHopper uma única vez com a melhor ordem encontrada para obter rota real
  const resultado = await ghRoute(melhor.seq);
  const { distKm, coords, instrucoes } = resultado;

  // Para multi-stop, associar instruções a cada segmento entre paradas
  // (GH retorna instrução com via_point para identificar as paradas intermediárias)
  const instrucoesPorParada = [];
  let segAtual = [];
  let paradaIdx = 0;
  for (const step of instrucoes) {
    segAtual.push(step);
    if (step.sign === 5 && paradaIdx < melhor.seq.length - 1) { // reached_via
      instrucoesPorParada.push({ pedidoId: melhor.seq[paradaIdx].pedidoId, tipo: melhor.seq[paradaIdx].tipo, steps: segAtual });
      segAtual = [];
      paradaIdx++;
    }
  }
  if (segAtual.length) {
    instrucoesPorParada.push({ pedidoId: melhor.seq[paradaIdx]?.pedidoId, tipo: melhor.seq[paradaIdx]?.tipo, steps: segAtual });
  }

  return {
    ids: pedidosIds,
    paradas: melhor.seq,
    coords,
    distKm,
    tempoMin: calcularTempoMinutos(distKm),
    instrucoes: instrucoesPorParada
  };
}

// ═══════════════════════════════════════════════════════════
// ACEITAR ROTA (motoboy) — valida 3 pedidos máx + 20 km total
// ═══════════════════════════════════════════════════════════
async function aceitarRota(id) {
  const p = pedidos.find(x => x.id === id);
  if (!p || p.status !== 'aguardando') return;

  const aceitosAtuais = pedidos.filter(x => x.status === 'aceito');

  // ─── Validação 1: limite de pedidos simultâneos ───
  if (aceitosAtuais.length >= MAX_PEDIDOS_MOTOBOY) {
    mostrarToast(`Limite de ${MAX_PEDIDOS_MOTOBOY} pedidos por motoboy atingido`, 'erro');
    return;
  }

  // ─── Validação 2: simular se a rota combinada cabe nos 20 km ───
  if (!obterApiKey()) {
    mostrarToast('Cole sua API Key GraphHopper na barra no topo para calcular rotas!', 'erro');
    return;
  }

  const simulacao = [...aceitosAtuais, p];
  mostrarToast('Calculando rota...', 'info');
  let rotaSim;
  try {
    rotaSim = await calcularRotaCombinada(simulacao);
  } catch(e) {
    if (e.message === 'SEM_KEY') mostrarToast('Cole sua API Key GraphHopper no topo!', 'erro');
    else mostrarToast('Erro ao calcular rota combinada', 'erro');
    return;
  }

  if (rotaSim.distKm > MAX_KM_ROTA_TOTAL) {
    mostrarToast(`Rota combinada teria ${rotaSim.distKm.toFixed(2)} km (limite ${MAX_KM_ROTA_TOTAL} km)`, 'erro');
    return;
  }

  // ─── Aceita e atualiza cache ───
  p.status = 'aceito';
  rotaCombinadaCache = rotaSim;
  pedidoSelecionadoId = id;

  renderizarPedidosPublicados();
  renderizarRotasMotoboy();
  desenharRotaCombinadaNoMapa();
  mostrarToast(`Pedido #${id.toString().slice(-4)} aceito! Rota: ${rotaSim.distKm.toFixed(2)} km · ${rotaSim.tempoMin} min`);
}

// ═══════════════════════════════════════════════════════════
// VER ROTA NO MAPA (motoboy) — mostra a rota combinada
// ═══════════════════════════════════════════════════════════
async function verRotaMapa(id) {
  pedidoSelecionadoId = id;
  const aceitos = pedidos.filter(p => p.status === 'aceito');

  // Se não há aceitos (clicou em um já entregue), mostra rota dele isolada
  const lista = aceitos.length ? aceitos : pedidos.filter(p => p.id === id);
  if (!lista.length) return;

  try {
    rotaCombinadaCache = await calcularRotaCombinada(lista);
    desenharRotaCombinadaNoMapa();
  } catch {
    mostrarToast('Erro ao recalcular rota', 'erro');
  }
}

// ═══════════════════════════════════════════════════════════
// DESENHAR ROTA COMBINADA NO MAPA (motoboy)
// ═══════════════════════════════════════════════════════════
function desenharRotaCombinadaNoMapa() {
  // Limpar layers antigos
  ['origem','destino','rota'].forEach(k => {
    if (lyr.moto[k]) { mapMoto.removeLayer(lyr.moto[k]); lyr.moto[k] = null; }
  });
  if (lyr.moto.paradas) {
    lyr.moto.paradas.forEach(m => mapMoto.removeLayer(m));
  }
  lyr.moto.paradas = [];

  if (!rotaCombinadaCache) return;

  // Desenhar marcadores para cada parada, numerados em sequência
  rotaCombinadaCache.paradas.forEach((stop, idx) => {
    const numero = idx + 1;
    const emoji  = stop.tipo === 'pickup' ? '🍽️' : '📍';
    const label  = stop.tipo === 'pickup' ? 'Retirar' : 'Entregar';
    const html = `
      <div style="position:relative;">
        <div style="font-size:30px;line-height:1;">${emoji}</div>
        <div style="position:absolute;top:-4px;right:-8px;background:#e8321a;color:#fff;border-radius:50%;width:18px;height:18px;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;">${numero}</div>
      </div>`;
    const icon = L.divIcon({ html, iconSize:[34,34], iconAnchor:[17,30], className:'' });
    const m = L.marker([stop.lat, stop.lng], { icon })
      .bindPopup(`<strong>${numero}. ${label}</strong><br>${stop.nome}<br><span style="color:#777;font-size:11px;">Pedido #${stop.pedidoId.toString().slice(-4)}</span>`)
      .addTo(mapMoto);
    lyr.moto.paradas.push(m);
  });

  // Desenhar polyline
  lyr.moto.rota = L.polyline(rotaCombinadaCache.coords, { color:'#ff6b00', weight:4, opacity:0.85 }).addTo(mapMoto);
  mapMoto.fitBounds(lyr.moto.rota.getBounds(), { padding:[40,40] });

  // Atualizar infos
  atualizarInfoEntrega('moto', rotaCombinadaCache.distKm);
  atualizarParadasMotoboy();
  renderizarInstrucoes();
}

// ═══════════════════════════════════════════════════════════
// LISTA DE PARADAS (motoboy)
// ═══════════════════════════════════════════════════════════
function atualizarParadasMotoboy() {
  const el = document.getElementById('pontosMapa-moto');
  if (!rotaCombinadaCache) {
    el.innerHTML = '<div style="font-size:12px;color:var(--texto-muted);">Aceite uma rota para ver os pontos.</div>';
    return;
  }
  el.innerHTML = rotaCombinadaCache.paradas.map((stop, idx) => {
    const numero = idx + 1;
    const cor = stop.tipo === 'pickup' ? 'ponto-R' : 'ponto-D';
    const emoji = stop.tipo === 'pickup' ? '🍽️' : '📍';
    const acao = stop.tipo === 'pickup' ? 'Retirar' : 'Entregar';
    return `
      <div class="ponto-item">
        <div class="ponto-num ${cor}">${numero}</div>
        <div style="display:flex;flex-direction:column;gap:2px;">
          <span style="font-size:12px;"><strong>${acao}</strong> · #${stop.pedidoId.toString().slice(-4)}</span>
          <span style="font-size:11px;color:var(--texto-muted);">${emoji} ${stop.nome}</span>
        </div>
      </div>
    `;
  }).join('');
}

// ═══════════════════════════════════════════════════════════
// CONFIRMAR ENTREGA (motoboy)
// ═══════════════════════════════════════════════════════════
async function confirmarEntrega(id) {
  const p = pedidos.find(x => x.id === id);
  if (!p || p.status !== 'aceito') return;
  if (!confirm(`Confirmar que o pedido #${id.toString().slice(-4)} foi entregue?`)) return;

  p.status = 'entregue';
  p.entregueEm = new Date().toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit' });

  // ─── Acumular métricas do dia ───
  metricas.motoboy.ganhos       += p.precoEntrega;
  metricas.motoboy.kmPercorridos += p.distKm;
  metricas.motoboy.entregasFeitas++;

  metricas.rest.lucroTotal      += p.lucroTotal;
  metricas.rest.vendasTotal     += p.vendaTotal;
  metricas.rest.pedidosEntregues++;
  metricas.rest.custoEntregas   = (metricas.rest.custoEntregas || 0) + p.precoEntrega;

  atualizarDashboards();

  // Recalcular rota combinada com os que ainda estão aceitos
  const restantes = pedidos.filter(x => x.status === 'aceito');
  if (restantes.length) {
    try {
      rotaCombinadaCache = await calcularRotaCombinada(restantes);
      desenharRotaCombinadaNoMapa();
    } catch {}
  } else {
    rotaCombinadaCache = null;
    pedidoSelecionadoId = null;
    ['origem','destino','rota'].forEach(k => {
      if (lyr.moto[k]) { mapMoto.removeLayer(lyr.moto[k]); lyr.moto[k] = null; }
    });
    if (lyr.moto.paradas) { lyr.moto.paradas.forEach(m => mapMoto.removeLayer(m)); lyr.moto.paradas = []; }
    atualizarInfoEntrega('moto', null);
    atualizarParadasMotoboy();
  }

  renderizarPedidosPublicados();
  renderizarRotasMotoboy();
  mostrarToast(`Entrega confirmada! +R$ ${p.precoEntrega.toFixed(2)}`);
}

// ═══════════════════════════════════════════════════════════
// DASHBOARDS DO DIA
// ═══════════════════════════════════════════════════════════
function fmt(val) {
  return `R$ ${val.toFixed(2).replace('.', ',')}`;
}

function atualizarDashboards() {
  const m = metricas;

  // ── Motoboy ──
  const media = m.motoboy.entregasFeitas
    ? m.motoboy.ganhos / m.motoboy.entregasFeitas
    : 0;
  document.getElementById('dmGanhos').textContent   = fmt(m.motoboy.ganhos);
  document.getElementById('dmKm').textContent       = `${m.motoboy.kmPercorridos.toFixed(1)} km`;
  document.getElementById('dmEntregas').textContent = m.motoboy.entregasFeitas;
  document.getElementById('dmMedia').textContent    = fmt(media);

  // Histórico por entrega
  const entregues = pedidos.filter(p => p.status === 'entregue');
  document.getElementById('dmHistorico').innerHTML = entregues.length ? `
    <div style="font-size:11px;color:var(--texto-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">Histórico de entregas</div>
    ${entregues.map(p => `
      <div class="item-row">
        <div class="item-row-left">
          <span style="font-family:'Bebas Neue',sans-serif;font-size:14px;color:var(--amarelo);">#${p.id.toString().slice(-4)}</span>
          <div style="font-size:12px;">
            <div>${p.origem.nome.slice(0,30)}${p.origem.nome.length>30?'…':''}</div>
            <div style="color:var(--texto-muted);">${p.entregueEm || ''} · ${p.distKm.toFixed(2)} km</div>
          </div>
        </div>
        <div class="item-row-right">
          <span class="lucro-chip">+${fmt(p.precoEntrega)}</span>
        </div>
      </div>
    `).join('')}
  ` : '';

  // ── Restaurante ──
  document.getElementById('drLucro').textContent         = fmt(m.rest.lucroTotal);
  document.getElementById('drVendas').textContent        = fmt(m.rest.vendasTotal);
  document.getElementById('drPedidos').textContent       = m.rest.pedidosEntregues;
  document.getElementById('drCustoEntregas').textContent = fmt(m.rest.custoEntregas || 0);
}

// ═══════════════════════════════════════════════════════════
// INSTRUCOES PASSO A PASSO
// ═══════════════════════════════════════════════════════════
let instrucoesFechado = false;

function toggleInstrucoes() {
  instrucoesFechado = !instrucoesFechado;
  document.getElementById('instrucoes-body').classList.toggle('fechado', instrucoesFechado);
  document.getElementById('instrucoes-icon').classList.toggle('fechado', instrucoesFechado);
}

function renderizarInstrucoes() {
  const body    = document.getElementById('instrucoes-body');
  const resumo  = document.getElementById('instrucoes-resumo');
  const cache   = rotaCombinadaCache;

  if (!cache || !cache.instrucoes?.length) {
    body.innerHTML = '<div class="empty" style="padding:28px;"><div class="empty-icon">🗺️</div>Aceite e visualize uma rota para ver as instruções aqui.</div>';
    resumo.textContent = 'Aceite uma rota para ver as instruções';
    return;
  }

  const totalSteps = cache.instrucoes.reduce((s, seg) => s + seg.steps.length, 0);
  resumo.textContent = `${totalSteps} passos · ${cache.distKm.toFixed(2)} km · ${cache.tempoMin} min`;

  // Montar HTML de todas as instruções segmentadas por parada
  const partes = [];
  const paradas = cache.paradas;
  let paradaIdx = 0;

  for (const seg of cache.instrucoes) {
    // Cabeçalho da parada de destino do segmento
    const destParada = seg.tipo === 'trecho'
      ? paradas[paradas.length - 1]
      : paradas.find(p => p.pedidoId === seg.pedidoId && p.tipo === seg.tipo);

    if (destParada || seg.tipo === 'trecho') {
      const parada = destParada || paradas[paradaIdx] || {};
      const eTipo  = parada.tipo === 'pickup' ? 'pickup' : parada.tipo === 'dropoff' ? 'dropoff' : '';
      const eIco   = parada.tipo === 'pickup' ? '🍽️ Retirar' : parada.tipo === 'dropoff' ? '📍 Entregar' : '🏁 Fim';
      const eLabel = `${eIco} — Pedido #${(parada.pedidoId || 0).toString().slice(-4)}`;
      partes.push(`<div class="step-parada-label">${eLabel}<span style="font-size:11px;color:var(--texto-muted);font-family:'DM Sans',sans-serif;font-weight:400;">${parada.nome || ''}</span></div>`);
      paradaIdx++;
    }

    // Passos do segmento
    for (let i = 0; i < seg.steps.length; i++) {
      const step = seg.steps[i];
      const eFim = step.sign === 4; // finish
      const eVia = step.sign === 5; // reached_via
      const ico  = iconeTurn(step.sign, step.texto);

      const numCls = eFim ? 'dropoff' : eVia ? 'pickup' : '';
      const distTxt = step.distancia > 5 ? `<div class="step-dist">📏 ${formatDist(step.distancia)}</div>` : '';

      // Nome da rua: priorizar step.rua, senão extrair do texto
      const rua = step.rua
        || (step.texto.match(/(?:pela|na|até a?|por)\s+(.+)/i)?.[1] || '');

      const textoLimpo = step.texto.replace(/\s*\[.*?\]/g,'').trim();

      partes.push(`
        <div class="instrucao-step">
          <span class="step-icon-turn">${ico}</span>
          <div class="step-text">
            ${rua ? `<div class="step-street">${rua}</div>` : ''}
            <div class="step-detail">${textoLimpo}</div>
            ${distTxt}
          </div>
        </div>
      `);
    }
  }

  body.innerHTML = partes.join('');
}

// ═══════════════════════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════════════════════
let toastTimer = null;
function mostrarToast(msg, tipo='ok') {
  const t   = document.getElementById('toast');
  const cor = tipo==='erro' ? 'var(--vermelho)' : tipo==='info' ? 'var(--azul)' : 'var(--verde)';
  const ico = tipo==='erro' ? '⚠️' : tipo==='info' ? 'ℹ️' : '✅';
  t.textContent = `${ico} ${msg}`;
  t.style.borderColor = cor;
  t.style.color = cor;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
}

// ─── Init ───
renderizarCardapio();
renderizarPedidoSelector();
</script>
